# Chave privada da API do Asaas; chaves de homologação começam com $aact_hmlg_.
ASAAS_API_KEY=cole_sua_chave_sandbox_aqui
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Em produção use: https://api.asaas.com/v3
# authToken criado no webhook do painel Asaas (32–255 caracteres); não reutilize a API key.
ASAAS_WEBHOOK_TOKEN=crie_um_token_longo_e_aleatorio_aqui

DB_HOST=localhost
DB_NAME=seu_banco
DB_USER=seu_usuario
DB_PASS=sua_senha
