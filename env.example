# ----------------- BANCO
DB_HOST=localhost
DB_PORT=3307
DB_NAME=educacaofinanceira
DB_USER=root
DB_PASS=

# Segredo compartilhado entre PHP e a API Flask administrativa.
# Troque por um valor aleatório com pelo menos 32 caracteres.
AFDE_ADMIN_API_SECRET=dev-only-change-this-secret-before-production-8f3c

# Porta local da API Flask administrativa
ADMIN_API_PORT=5001

# ----------------- ASAAS
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# ------------------- PLUGGY
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --------------------- BRAPI
BRAPI_API_KEY=

# URL pública/local usada pela página admin para chamar a API Flask
ADMIN_API_URL=http://127.0.0.1:5001

# --------------------- CHATBOT
# Chave do Google AI Studio; nunca coloque no JavaScript ou no repositório.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CHATBOT_API_URL=http://127.0.0.1:5000

# --------------------- GOOGLE LOGIN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve coincidir exatamente com a URI autorizada no Google Cloud Console.
# Exemplo local: http://localhost/PTCC-EducacaoFinanceira/back-end/google-callback.php
GOOGLE_REDIRECT_URL=
