# Configuração Apache do AFDE. Requer AllowOverride FileInfo/Indexes/AuthConfig.
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Não permitir download de segredos, dumps, logs, backups ou configurações.
<FilesMatch "^\.env|(^|/)(composer\.(json|lock)|package(-lock)?\.json|.*\.(sql|log|bak|ini|zip))$">
    Require all denied
</FilesMatch>

# Não expor controle de versão nem arquivos de configuração de editor.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)(\.git|\.svn|\.idea|\.vscode)(/|$)" - [F,L]
</IfModule>
